    aformat { @Cell ml { 0c } mr { 1.5c } A | @Cell mr { 0c } B }
    mv { 0.3c }
{
@Rowa
    ma { 0i }
    A { A1:: @Circle }
    B { B1:: @Circle }
@Rowa
    A { A2:: @Circle }
    B { B2:: @Circle }
@Rowa
    A { A3:: @Circle }
    B { B3:: @Circle }
@Rowa
    A { A4:: @Circle }
    B { B4:: @Circle }
    mb { 0i }
}
//
@Line from { A1 } to { B1 }
@Line from { A1 } to { B2 }
@Line from { A1 } to { B3 } pathwidth { thick }
@Line from { A1 } to { B4 }
@Line from { A2 } to { B1 } pathwidth { thick }
@Line from { A2 } to { B2 }
@Line from { A3 } to { B2 } pathwidth { thick }
@Line from { A4 } to { B2 }
